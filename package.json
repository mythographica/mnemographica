{
	"name": "mnemographica",
	"displayName": "Mnemonica Graphica",
	"description": "Visualize mnemonica type hierarchies with interactive D3 force-directed graphs",
	"version": "0.1.0",
	"publisher": "mnemonica",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Visualization",
		"Programming Languages"
	],
	"keywords": [
		"mnemonica",
		"inheritance",
		"prototype",
		"typescript",
		"visualization"
	],
	"activationEvents": [
			"onCommand:mnemographica.showTypeGraph",
			"onCommand:mnemographica.showTypeGraph25D",
			"workspaceContains:**/*.ts",
			"workspaceContains:**/package.json"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "mnemographica.showTypeGraph",
				"title": "Ψ 2D/3D",
				"category": "Mnemonica"
			},
			{
				"command": "mnemographica.showTypeGraph25D",
				"title": "Ψ 2.5D",
				"category": "Mnemonica"
			},
			{
				"command": "mnemographica.refreshGraph",
				"title": "Refresh Type Graph",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.refreshTree",
				"title": "Refresh Tree View",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.showTreeView",
				"title": "Show Tree View",
				"category": "Mnemonica",
				"icon": "$(list-tree)"
			},
			{
				"command": "mnemographica.showStrategyStatus",
				"title": "Show Strategy MCP Status",
				"category": "Mnemonica",
				"icon": "$(server-environment)"
			},
			{
				"command": "mnemographica.showLogger",
				"title": "Show Logger",
				"category": "Mnemonica",
				"icon": "$(output)"
			},
			{
				"command": "mnemographica.openTreeItem",
				"title": "Open Definition",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showUsages",
				"title": "Show Usages",
				"category": "Mnemonica",
				"icon": "$(references)"
			},
			{
				"command": "mnemographica.selectWorkspace",
				"title": "Select Workspace",
				"category": "Mnemonica",
				"icon": "$(folder)"
			},
			{
				"command": "mnemographica.revealInExplorer",
				"title": "Reveal in Explorer View",
				"category": "Mnemonica",
				"icon": "$(folder-opened)"
			},
			{
				"command": "mnemographica.goToUsage",
				"title": "Go to Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.goToType",
				"title": "Go to Type",
				"category": "Mnemonica",
				"icon": "$(symbol-class)"
			},
			{
				"command": "mnemographica.goToDefinition",
				"title": "Go to Definition",
				"category": "Mnemonica",
				"icon": "$(symbol-method)"
			},
			{
				"command": "mnemographica.openType",
				"title": "Open Type",
				"category": "Mnemonica",
				"icon": "$(symbol-class)"
			},
			{
				"command": "mnemographica.navigateToLocation",
				"title": "Go to Location",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showFlows",
				"title": "Show Flows",
				"category": "Mnemonica",
				"icon": "$(debug-alt)"
			},
			{
				"command": "mnemographica.clearFlowFilter",
				"title": "Show All Flows",
				"category": "Mnemonica",
				"icon": "$(clear-all)"
			},
			{
				"command": "mnemographica.refreshGenTree",
				"title": "Refresh By Generation",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "mnemographica.showTypeGraph"
				},
				{
					"command": "mnemographica.showTypeGraph25D"
				},
				{
					"command": "mnemographica.refreshGraph"
				},
				{
					"command": "mnemographica.refreshTree"
				},
				{
					"command": "mnemographica.showTreeView"
				},
				{
					"command": "mnemographica.showStrategyStatus"
				},
				{
					"command": "mnemographica.showLogger"
				},
				{
					"command": "mnemographica.selectWorkspace"
				},
				{
					"command": "mnemographica.refreshGenTree"
				}
			],
			"editor/title": [
				{
					"command": "mnemographica.showTypeGraph",
					"when": "resourceExtname == .ts",
					"group": "navigation"
				}
			],
			"panel/title": [
				{
					"command": "mnemographica.showTypeGraph",
					"when": "activePanel == mnemonicaGraph",
					"group": "navigation"
				},
				{
					"command": "mnemographica.showTypeGraph25D",
					"when": "activePanel == mnemonicaGraph25D",
					"group": "navigation"
				}
			],
			"view/title": [
				{
					"command": "mnemographica.showTypeGraph",
					"group": "navigation"
				},
				{
					"command": "mnemographica.showTypeGraph25D",
					"group": "navigation"
				},
				{
					"command": "mnemographica.selectWorkspace",
					"when": "view == mnemonicaTypes",
					"group": "navigation@2"
				},
			{
				"command": "mnemographica.clearFlowFilter",
				"when": "view == mnemonicaFlow",
				"group": "navigation@1"
			},
			{
				"command": "mnemographica.refreshGenTree",
				"when": "view == mnemonicaGen",
				"group": "navigation@1"
			}
			],
			"view/item/context": [
				{
					"command": "mnemographica.openTreeItem",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.openType",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@2"
				},
			{
				"command": "mnemographica.showUsages",
				"when": "view == mnemonicaTypes && viewItem == navigable",
				"group": "navigation@3"
			},
			{
				"command": "mnemographica.showFlows",
				"when": "view == mnemonicaTypes && viewItem == navigable",
				"group": "navigation@4"
			},
			{
				"command": "mnemographica.openType",
				"when": "view == mnemonicaTypes && viewItem == navigableType",
				"group": "navigation@1"
			},
			{
				"command": "mnemographica.openTreeItem",
				"when": "view == mnemonicaTypes && viewItem == navigableType",
				"group": "navigation@2"
			},
			{
				"command": "mnemographica.showUsages",
				"when": "view == mnemonicaTypes && viewItem == navigableType",
				"group": "navigation@3"
			},
			{
				"command": "mnemographica.showFlows",
				"when": "view == mnemonicaTypes && viewItem == navigableType",
				"group": "navigation@4"
			},
				{
					"command": "mnemographica.revealInExplorer",
					"when": "view == mnemonicaUsages",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.goToUsage",
					"when": "view == mnemonicaUsages",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.goToType",
					"when": "view == mnemonicaUsages",
					"group": "navigation@3"
				},
				{
					"command": "mnemographica.goToDefinition",
					"when": "view == mnemonicaUsages",
					"group": "navigation@4"
				}
			],
			"explorer/context": [
				{
					"command": "mnemographica.showTypeGraph",
					"when": "resourceExtname == .ts",
					"group": "mnemonica@1"
				},
				{
					"command": "mnemographica.showTypeGraph25D",
					"when": "resourceExtname == .ts",
					"group": "mnemonica@2"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mnemonica",
					"title": "Mnemonica",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"views": {
			"mnemonica": [
				{
					"id": "mnemonicaUsages",
					"name": "Usages",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaTypes",
					"name": "Types",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaFlow",
					"name": "Flow",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaGen",
					"name": "By Generation",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"configuration": {
			"title": "Mnemonica Graphica",
			"properties": {
				"mnemographica.layout": {
					"type": "string",
					"enum": [
						"force",
						"tree",
						"cluster"
					],
					"default": "force",
					"description": "Graph layout algorithm"
				},
				"mnemographica.nodeSize": {
					"type": "string",
					"enum": [
						"propertyCount",
						"uniform"
					],
					"default": "propertyCount",
					"description": "How to size nodes"
				},
				"mnemographica.showProperties": {
					"type": "boolean",
					"default": true,
					"description": "Show properties on hover"
				}
			}
		},
		"outputChannels": [
			{
				"id": "mnemonicaLogger",
				"name": "Mnemonica Logger"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "npm run tactica:generate && rm -rf ./out && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"package": "vsce package",
		"tactica:generate": "tactica --generate",
		"tactica:watch": "tactica --watch"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/three": "^0.183.1",
		"@types/vscode": "^1.74.0",
		"@types/ws": "^8.5.10",
		"@typescript-eslint/eslint-plugin": "^6.7.0",
		"@typescript-eslint/parser": "^6.7.0",
		"@vscode/test-electron": "^2.3.0",
		"eslint": "^8.50.0",
		"typescript": "^5.2.0"
	},
	"dependencies": {
		"@mnemonica/tactica": "file:../tactica",
		"@mnemonica/topologica": "file:../topologica",
		"d3-force-3d": "^3.0.6",
		"mnemonica": "file:../core",
		"three": "^0.174.0",
		"ws": "^8.19.0"
	}
}
