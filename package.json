{
	"name": "mnemographica",
	"displayName": "Mnemonica Graphica",
	"description": "Explore mnemonica type hierarchies: definitions, types, usages, execution flow and generations, with go-to-definition navigation",
	"version": "0.1.0",
	"publisher": "mnemonica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/mnemographica.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/mnemographica/issues"
	},
	"homepage": "https://github.com/mythographica/mnemographica#readme",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Visualization",
		"Programming Languages"
	],
	"keywords": [
		"mnemonica",
		"inheritance",
		"prototype",
		"typescript",
		"visualization"
	],
	"activationEvents": [
		"workspaceContains:**/*.ts",
		"workspaceContains:**/package.json",
		"onView:mnemonicaWelcome",
		"onView:mnemonicaUsages",
		"onView:mnemonicaTypes",
		"onView:mnemonicaFlow",
		"onView:mnemonicaGen"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "mnemographica.showTypeGraph",
				"title": "Ψ 3D",
				"category": "Mnemonica"
			},
			{
				"command": "mnemographica.refreshGraph",
				"title": "Refresh Type Graph",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.refreshTree",
				"title": "Refresh Tree View",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			},
			{
				"command": "mnemographica.showTreeView",
				"title": "Show Tree View",
				"category": "Mnemonica",
				"icon": "$(list-tree)"
			},
			{
				"command": "mnemographica.showStrategyStatus",
				"title": "Show Strategy MCP Status",
				"category": "Mnemonica",
				"icon": "$(server-environment)"
			},
			{
				"command": "mnemographica.showLogger",
				"title": "Show Logger",
				"category": "Mnemonica",
				"icon": "$(output)"
			},
			{
				"command": "mnemographica.openTreeItem",
				"title": "Open Definition",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showUsages",
				"title": "Show Usages",
				"category": "Mnemonica",
				"icon": "$(references)"
			},
			{
				"command": "mnemographica.openUsage",
				"title": "Open Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.navigateToUsage",
				"title": "Navigate to Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.selectWorkspace",
				"title": "Select Workspace",
				"category": "Mnemonica",
				"icon": "$(folder)"
			},
			{
				"command": "mnemographica.revealInExplorer",
				"title": "Reveal in Explorer View",
				"category": "Mnemonica",
				"icon": "$(folder-opened)"
			},
			{
				"command": "mnemographica.goToUsage",
				"title": "Go to Usage",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.goToType",
				"title": "Go to Type",
				"category": "Mnemonica",
				"icon": "$(symbol-class)"
			},
			{
				"command": "mnemographica.goToDefinition",
				"title": "Go to Definition",
				"category": "Mnemonica",
				"icon": "$(symbol-method)"
			},
			{
				"command": "mnemographica.openType",
				"title": "Open Type",
				"category": "Mnemonica",
				"icon": "$(symbol-class)"
			},
			{
				"command": "mnemographica.navigateToLocation",
				"title": "Go to Location",
				"category": "Mnemonica",
				"icon": "$(go-to-file)"
			},
			{
				"command": "mnemographica.showFlows",
				"title": "Show Flows",
				"category": "Mnemonica",
				"icon": "$(debug-alt)"
			},
			{
				"command": "mnemographica.clearFlowFilter",
				"title": "Show All Flows",
				"category": "Mnemonica",
				"icon": "$(clear-all)"
			},
			{
				"command": "mnemographica.refreshGenTree",
				"title": "Refresh By Generation",
				"category": "Mnemonica",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "mnemographica.showTypeGraph"
				},
				{
					"command": "mnemographica.refreshGraph"
				},
				{
					"command": "mnemographica.refreshTree"
				},
				{
					"command": "mnemographica.showTreeView"
				},
				{
					"command": "mnemographica.showStrategyStatus"
				},
				{
					"command": "mnemographica.showLogger"
				},
				{
					"command": "mnemographica.selectWorkspace"
				},
				{
					"command": "mnemographica.refreshGenTree"
				}
			],
			"view/title": [
				{
					"command": "mnemographica.showTypeGraph",
					"when": "view == mnemonicaTypes",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.selectWorkspace",
					"when": "view == mnemonicaTypes",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.clearFlowFilter",
					"when": "view == mnemonicaFlow",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.refreshGenTree",
					"when": "view == mnemonicaGen",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "mnemographica.openTreeItem",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.openType",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.showUsages",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@3"
				},
				{
					"command": "mnemographica.showFlows",
					"when": "view == mnemonicaTypes && viewItem == navigable",
					"group": "navigation@4"
				},
				{
					"command": "mnemographica.openType",
					"when": "view == mnemonicaTypes && viewItem == navigableType",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.openTreeItem",
					"when": "view == mnemonicaTypes && viewItem == navigableType",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.showUsages",
					"when": "view == mnemonicaTypes && viewItem == navigableType",
					"group": "navigation@3"
				},
				{
					"command": "mnemographica.showFlows",
					"when": "view == mnemonicaTypes && viewItem == navigableType",
					"group": "navigation@4"
				},
				{
					"command": "mnemographica.revealInExplorer",
					"when": "view == mnemonicaUsages",
					"group": "navigation@1"
				},
				{
					"command": "mnemographica.goToUsage",
					"when": "view == mnemonicaUsages",
					"group": "navigation@2"
				},
				{
					"command": "mnemographica.goToType",
					"when": "view == mnemonicaUsages",
					"group": "navigation@3"
				},
				{
					"command": "mnemographica.goToDefinition",
					"when": "view == mnemonicaUsages",
					"group": "navigation@4"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mnemonica",
					"title": "Mnemonica",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"views": {
			"mnemonica": [
				{
					"id": "mnemonicaWelcome",
					"name": "Welcome",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaUsages",
					"name": "Usages",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaTypes",
					"name": "Types",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaFlow",
					"name": "Flow",
					"icon": "media/psi-icon.svg"
				},
				{
					"id": "mnemonicaGen",
					"name": "By Generation",
					"icon": "media/psi-icon.svg"
				}
			]
		},
		"outputChannels": [
			{
				"id": "mnemonicaLogger",
				"name": "Mnemonica Logger"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "npm run tactica:generate && rm -rf ./out && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "node test/registry-loading.test.js && node test/types-model.test.js && node test/types-parser.test.js && node test/trace-ingest.test.js",
		"package": "vsce package",
		"tactica:generate": "tactica --generate --verbose",
		"tactica:watch": "tactica --watch"
	},
	"devDependencies": {
		"@mnemonica/tactica": "^0.1.7",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.74.0",
		"@types/ws": "^8.5.10",
		"eslint": "^9.39.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"dependencies": {
		"@mnemonica/topologica": "^0.0.8",
		"mnemonica": "^1.2.5",
		"ws": "^8.19.0"
	}
}
