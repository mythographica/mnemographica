# Sources and dev-time files — the vsix ships only what the extension needs at runtime
.vscode/**
src/**
test/**
.tactica/**
out/src/test/**
**/*.map
**/.eslintrc*
**/tsconfig.json
**/*.tsbuildinfo

# Repo meta
.git*
.gitignore
.husky/**
reports/**
plans/**
logs/**
design_handoff_3d_scene/**
MnemoGraphica design.zip
*.vsix
node_modules/.package-lock.json

# per-user 3D layout saves + dev configs
.mnemographica/**
.github/**
eslint.config.js

# Docs that are for contributors, not extension users
AGENTS.md
CHANGELOG.md
INSTALL.md

# node_modules dev weight — types, tests, sources and readmes are never
# required at runtime (~45% of the unpacked payload; LICENSE* stays)
node_modules/**/*.d.ts
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.test.*
node_modules/**/*.spec.*
node_modules/**/[Rr][Ee][Aa][Dd][Mm][Ee]*
node_modules/**/CHANGELOG*
node_modules/**/HISTORY*
node_modules/zod/src/**
